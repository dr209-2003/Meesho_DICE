# Server-side only. Set these in Vercel → Project → Settings → Environment Variables
# (the Vercel Marketplace "Upstash for Redis" integration adds them automatically).
# Never prefix them with VITE_ — that would expose them to the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names also accepted: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Optional: namespace for the Redis keys (default meesho-quick:v1)
# MEESHO_QUICK_KEY_PREFIX=meesho-quick:v1
